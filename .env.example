# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Plaid (set these in Convex dashboard env as well)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Clerk JWT issuer for Convex auth.config.ts (set in Convex env)
# e.g. https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# PostHog (project token is public by design; leave empty to disable)
# Host example: https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
